# Copia estas variables en el entorno del servidor (no subas un .env real).
# Genera una clave con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-larga

# Opcional: ruta absoluta de SQLite fuera de la carpeta pública.
# Por defecto se usa instance/queivzz.sqlite3 dentro del proyecto.
# DATABASE_PATH=/home/tuusuario/Queivzz/instance/queivzz.sqlite3

# En PythonAnywhere (HTTPS) conviene activarlo. En local con HTTP déjalo en 0.
SESSION_COOKIE_SECURE=0
